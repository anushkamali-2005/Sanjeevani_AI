# ==============================================================================
# Darukaa.Earth Biodiversity Intelligence Chatbot — Environment Configuration
# ==============================================================================

# --- Live Web Search (Tavily Preferred) ---
# When set, live web search queries are executed via Tavily API with full depth and real URLs.
# If not set, system automatically uses real public search fallback (Wikipedia/weather APIs).
TAVILY_API_KEY=

# --- Grounded Conversational LLM API Keys (Optional) ---
# If any key is provided, the system uses the corresponding model to synthesize natural answers.
# If no key is set, the system seamlessly uses offline deterministic extractive synthesis.
# Groq (Free fast inference via https://console.groq.com):
GROQ_API_KEY=
# Grok / xAI (https://console.x.ai):
GROK_API_KEY=
# Google Gemini (https://aistudio.google.com):
GEMINI_API_KEY=
# OpenAI (https://platform.openai.com):
OPENAI_API_KEY=
# Anthropic Claude (https://console.anthropic.com):
ANTHROPIC_API_KEY=

# --- Retrieval Relevance / Confidence Thresholds ---
# MS-MARCO Cross-Encoder logit threshold (0.0: standard semantic relevance cutoff)
RERANK_RELEVANCE_THRESHOLD=0.0

# Dense Vector Cosine Similarity threshold (1.0 - cosine_distance >= 0.58)
DENSE_RELEVANCE_THRESHOLD=0.58

# BM25 Sparse Keyword Score threshold
BM25_RELEVANCE_THRESHOLD=3.0
