# Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here

# Splunk Configuration (Free Tier)
SPLUNK_HOST=localhost
SPLUNK_PORT=8089
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=changeme
SPLUNK_SCHEME=https

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Database
DATABASE_URL=sqlite+aiosqlite:///./support_agent.db

# Redis (optional, falls back to in-memory)
REDIS_URL=redis://localhost:6379/0

# Agent Configuration
CONFIDENCE_THRESHOLD_AUTO=0.90
CONFIDENCE_THRESHOLD_RECOMMEND=0.70
MAX_PARALLEL_ACTIONS=5
